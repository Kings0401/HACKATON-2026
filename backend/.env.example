# Copiar a backend/.env (ignorado por Git). NUNCA usar estas claves en el frontend.
NCLUB_BACKEND_MODE=supabase            # supabase | memory (datos ficticios, siempre simulation=true)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SECRET_KEY=                   # sb_secret_... (rotar si se compartió)
ROBOT_API_KEY=                         # >= 16 caracteres: python -c "import secrets;print(secrets.token_urlsafe(32))"
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PUBLIC_APP_URL=http://127.0.0.1:5173   # base del enlace QR de la ruta para el celular
PUBLIC_API_URL=http://127.0.0.1:8000   # base del stream MJPEG que ve el navegador ADMIN
STREAM_SECRET=                         # firma de tokens del stream (aleatorio si se omite)
FACE_THRESHOLD=0.62
FACE_REQUIRED_CATEGORIES=VIP,REGULAR,PERSONAL_INTERNO,TRABAJADOR_EXTERNO
SPEAKER_THRESHOLD=0.25               # similitud coseno SpeechBrain ECAPA-TDNN
VOICES_BUCKET=voces-nclub           # bucket privado creado por supabase/recepcion_robot.sql
ALLOW_STATIC_CREDENTIALS=true          # códigos de demostración NFC-VIP-001, QR-INV-001...
ALLOW_SIMULATION=true
STORE_EVIDENCE=false                   # fotogramas/audio solo con consentimiento y política
EVIDENCE_RETENTION_DAYS=30
ROUTE_SHARE_TTL_MIN=30
